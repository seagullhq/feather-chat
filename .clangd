CompileFlags:
  # No CompilationDatabase override: clangd's default search looks for
  # compile_commands.json in every parent directory of the source file, i.e.
  # the repo root. The build copies its database there for every preset
  # (client/CMakeLists.txt), and the justfile / scripts/windows-build.ps1
  # recipes refresh it too, so this one config works on every platform. This key
  # used to point at dist/client-windows, which left Linux with no database at
  # all and every Qt include missing; a list of both build dirs is not a fix, as
  # clangd accepts a single directory and silently ignores the value.
  Add:
    - -Wno-unknown-pragmas
  # Qt adds this GCC 16 option to the compilation database. It only affects
  # code generation, and clangd's Clang frontend cannot parse it.
  Remove:
    - -mno-direct-extern-access

# clangd inserts the header where a symbol is declared, so Qt completions bring
# in <qwidget.h>, <qapplication.h>, ... while Qt's documented spelling is the
# class-named header (<QWidget>), a separate file that only includes qwidget.h.
# Qt's "IWYU pragma: export" on those files makes <QWidget> valid to write, but
# nothing maps qwidget.h back to it, so the insertion cannot be corrected from
# here. Off means includes are typed by hand, in Qt style.
Completion:
  HeaderInsertion: Never
