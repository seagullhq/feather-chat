CompileFlags:
  CompilationDatabase: dist/client
  Add:
    - -Wno-unknown-pragmas
  QueryDriver:
    # clangd must ask the configured compiler for MSVC/SDK include paths on
    # Windows; it refuses to run unknown drivers otherwise.
    - "F:/Program Files/LLVM/bin/clang++.exe"
    - "C:/Program Files (x86)/Microsoft Visual Studio/2022/BuildTools/VC/Tools/MSVC/*/bin/Hostx64/x64/cl.exe"