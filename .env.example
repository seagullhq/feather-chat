# Local development only — these match docker-compose.yaml, so
# `cp .env.example .env && docker compose up -d` works with no edits.
# Change them for anything reachable from outside your machine.
MONGO_ROOT_USERNAME=feather
MONGO_ROOT_PASSWORD=feather-dev-password
MONGO_DBNAME=feather
MONGO_HOST=127.0.0.1
