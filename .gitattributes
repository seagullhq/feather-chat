# Normalize line endings: LF in the repository, native in the working tree.
* text=auto

# Always LF, even checked out on Windows: shells and build tools choke on CRLF.
*.sh      text eol=lf
justfile  text eol=lf

# gofmt has no CRLF mode and reports every line of a CRLF file as unformatted,
# so Go sources must never be checked out with native Windows endings.
*.go      text eol=lf

# Always CRLF for Windows-only scripts.
*.bat text eol=crlf
*.ps1 text eol=crlf

# Never touched, never diffed as text.
*.png  binary
*.jpg  binary
*.ico  binary
*.icns binary
*.opus binary
*.wav  binary
